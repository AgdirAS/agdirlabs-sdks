{
    "name": "agdirlabs/email",
    "description": "Official PHP SDK for Agdir Email — programmatic SMTP for developers. Includes Laravel and Symfony Mailer transports.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://agdir.email",
    "keywords": [
        "email",
        "smtp",
        "transactional-email",
        "email-api",
        "webhooks",
        "agdir",
        "laravel",
        "symfony-mailer"
    ],
    "authors": [
        {
            "name": "Agdir AS",
            "homepage": "https://agdir.no"
        }
    ],
    "support": {
        "issues": "https://github.com/AgdirAS/agdirlabs-sdks/issues",
        "source": "https://github.com/AgdirAS/agdirlabs-sdks/tree/main/php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/mailer": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client (or use symfony/http-client)",
        "symfony/http-client": "A PSR-18 HTTP client (or use guzzlehttp/guzzle)",
        "symfony/mailer": "For the agdir+api:// Symfony Mailer transport",
        "laravel/framework": "For the Laravel service provider, facade and `agdir` mail transport"
    },
    "autoload": {
        "psr-4": {
            "AgdirLabs\\Email\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgdirLabs\\Email\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AgdirLabs\\Email\\Laravel\\AgdirEmailServiceProvider"
            ],
            "aliases": {
                "AgdirEmail": "AgdirLabs\\Email\\Laravel\\Facades\\AgdirEmail"
            }
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:live": "phpunit --testsuite live",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
