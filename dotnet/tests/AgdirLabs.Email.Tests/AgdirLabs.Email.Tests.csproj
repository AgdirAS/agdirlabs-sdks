<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 exercises the netstandard2.0 build (.NET Framework); it only runs on Windows. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(IncludeNetFx)' == 'true'">$(TargetFrameworks);net472</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AgdirLabs.Email.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA2007;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
  </ItemGroup>

  <!-- `-p:TestNetStandard=true` runs the tests against the netstandard2.0 build of the SDK (on any OS). -->
  <PropertyGroup Condition="'$(TestNetStandard)' == 'true'">
    <SdkTargetFramework>TargetFramework=netstandard2.0</SdkTargetFramework>
  </PropertyGroup>
  <ItemGroup Condition="'$(TestNetStandard)' == 'true'">
    <!-- The netstandard2.0 build's own dependencies (a net8.0 restore doesn't flow them). -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgdirLabs.Email\AgdirLabs.Email.csproj" SetTargetFramework="$(SdkTargetFramework)" />
    <ProjectReference Include="..\..\src\AgdirLabs.Email.Extensions.DependencyInjection\AgdirLabs.Email.Extensions.DependencyInjection.csproj" SetTargetFramework="$(SdkTargetFramework)" />
  </ItemGroup>

</Project>
